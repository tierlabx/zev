{
	"name": "zev-web",
	"private": true,
	"scripts": {
		"dev": "pnpm -F admin dev",
		"build": "pnpm -F admin build",
		"lint": "biome check --write . && pnpm run typecheck",
		"format": "biome format --write .",
		"typecheck": "pnpm -F admin exec tsc -b",
		"storybook": "pnpm -F admin storybook",
		"build-storybook": "pnpm -F admin build-storybook",
		"shadcn:add": "pnpm dlx shadcn@latest add -c apps/admin",
		"prepare": "node -e \"try { require('child_process').execSync('git config core.hooksPath .githooks', { stdio: 'ignore' }); } catch {}\""
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"shadcn": "^4.11.0"
	}
}
